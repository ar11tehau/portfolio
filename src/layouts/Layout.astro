---
import '../styles/global.css';
import { content, site, type Locale } from '../i18n/content';
import portrait from '../assets/portrait.jpeg';

interface Props {
	lang: Locale;
	title?: string;
	description?: string;
	/** Chemin de la page dans chaque langue, pour les balises hreflang */
	alternates?: Partial<Record<Locale, string>>;
	noindex?: boolean;
	bodyClass?: string;
}

const {
	lang,
	title = content[lang].meta.title,
	description = content[lang].meta.description,
	alternates = {},
	noindex = false,
	bodyClass = 'bg-sable',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const otherLocale: Locale = lang === 'fr' ? 'en' : 'fr';

const person = {
	'@type': 'Person',
	'@id': `${site.url}/#person`,
	name: site.name,
	url: site.url,
	image: new URL(portrait.src, site.url).href,
	jobTitle: lang === 'fr' ? 'Développeur full-stack' : 'Full-stack developer',
	worksFor: { '@type': 'Organization', name: 'Datakode' },
	address: { '@type': 'PostalAddress', addressLocality: 'Toulouse', addressCountry: 'FR' },
	knowsAbout: ['Laravel', 'PHP', 'Vue.js', 'Nuxt', 'TypeScript', 'Node.js', 'Astro'],
	sameAs: [site.github, site.linkedin],
};

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		person,
		{
			'@type': 'WebSite',
			'@id': `${site.url}/#website`,
			url: site.url,
			name: site.name,
			inLanguage: ['fr', 'en'],
			publisher: { '@id': person['@id'] },
		},
		{
			'@type': 'ProfilePage',
			url: canonical,
			name: title,
			description,
			inLanguage: lang,
			isPartOf: { '@id': `${site.url}/#website` },
			mainEntity: { '@id': person['@id'] },
		},
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="theme-color" content="#f7f2e8" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		{
			Object.entries(alternates).map(([locale, path]) => (
				<link rel="alternate" hreflang={locale} href={new URL(path, site.url).href} />
			))
		}
		{alternates.fr && <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, site.url).href} />}

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={content[lang].meta.ogLocale} />
		<meta property="og:locale:alternate" content={content[otherLocale].meta.ogLocale} />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class:list={['min-h-svh antialiased', bodyClass]}>
		<slot />
	</body>
</html>
