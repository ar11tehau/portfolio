---
import type { Content } from '../i18n/content';
import Timeline from './Timeline.astro';

interface Props {
	t: Content;
}

const { t } = Astro.props;
---

<section id="parcours" class="bg-zinc-950 px-6 py-24 text-zinc-100" aria-labelledby="career-heading">
	<div class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm font-medium tracking-[0.2em] text-zinc-400 uppercase">{t.career.eyebrow}</p>

		<h2 id="career-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
			{t.career.title}
		</h2>

		<div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-2">
			<Timeline heading={t.career.experience} items={t.career.experienceItems} />
			<div>
				<Timeline heading={t.career.education} items={t.career.educationItems} />
				<p class="mt-10 text-sm text-zinc-400">{t.career.languages}</p>
			</div>
		</div>
	</div>
</section>
