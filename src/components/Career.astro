---
import type { Content } from '../i18n/content';
import Timeline from './Timeline.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	t: Content;
}

const { t } = Astro.props;
---

<section id="parcours" class="bg-white px-6 py-24 text-ocean" aria-labelledby="career-heading">
	<div class="mx-auto max-w-5xl">
		<SectionHeading index="03" eyebrow={t.career.eyebrow} title={t.career.title} id="career-heading" />

		<div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-2">
			<Timeline heading={t.career.experience} items={t.career.experienceItems} />
			<div>
				<Timeline heading={t.career.education} items={t.career.educationItems} />
				<p class="mt-10 font-mono text-xs tracking-wider text-slate-600">{t.career.languages}</p>
				<p class="mt-2 font-mono text-xs tracking-wider text-brique">{t.career.offScreen}</p>
			</div>
		</div>
	</div>
</section>
