---
const email = 'arii.fullstack@gmail.com';

const links = [
	{ label: 'GitHub', href: 'https://github.com/ar11tehau' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/domelier' },
] as const;

const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-zinc-900 bg-zinc-950 px-6 py-16 text-zinc-100">
	<div class="mx-auto flex max-w-5xl flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="text-sm font-medium tracking-[0.2em] text-zinc-500 uppercase">Contact</p>
			<p class="mt-4 max-w-md text-lg text-zinc-300">
				Un projet, une mission ou simplement une question technique ?
			</p>
			<a
				href={`mailto:${email}`}
				class="mt-3 inline-block text-zinc-100 underline decoration-zinc-700 underline-offset-4 transition-colors hover:decoration-zinc-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-100"
			>
				{email}
			</a>
		</div>

		<div class="flex flex-col gap-4 sm:items-end">
			<ul class="flex gap-6 text-sm">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-zinc-400 transition-colors hover:text-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-100"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<p class="text-xs text-zinc-600">© {year} Ariitehau Domelier</p>
		</div>
	</div>
</footer>
