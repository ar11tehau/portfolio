---
import { site, type Content } from '../i18n/content';

interface Props {
	t: Content;
}

const { t } = Astro.props;

const links = [
	{ label: 'GitHub', href: site.github },
	{ label: 'LinkedIn', href: site.linkedin },
] as const;

const year = new Date().getFullYear();
---

<footer id="contact" class="bg-ocean px-6 py-20 text-sable">
	<div class="mx-auto flex max-w-5xl flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="font-mono text-xs tracking-[0.2em] text-lagon-clair uppercase"><span class="text-brique-clair">04 /</span> {t.contact.eyebrow}</p>
			<p class="mt-4 max-w-xl font-display text-3xl font-medium text-white">{t.contact.lead}</p>
			<p class="mt-4 max-w-xl text-sable/80">{t.contact.sub}</p>
			<a
				href={`mailto:${site.email}`}
				class="mt-4 inline-block font-mono text-sm text-lagon-clair underline decoration-lagon-clair/40 underline-offset-4 transition-colors hover:decoration-lagon-clair focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lagon-clair"
			>
				{site.email}
			</a>
		</div>

		<div class="flex flex-col gap-4 sm:items-end">
			<ul class="flex gap-6 text-sm">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="font-mono text-xs tracking-wider text-sable/70 uppercase transition-colors hover:text-lagon-clair focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lagon-clair"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<p class="font-mono text-[11px] text-sable/50">© {year} {site.name}</p>
		</div>
	</div>
</footer>
