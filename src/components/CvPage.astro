---
import Layout from '../layouts/Layout.astro';
import Timeline from './Timeline.astro';
import { content, site, type Locale } from '../i18n/content';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'fr' ? '/' : '/en/';
const skills = [...new Set(t.expertise.domains.flatMap((domain) => domain.tags))];
const projects = t.projects.items.filter((project) => project.status === 'production');
---

<Layout
	lang={lang}
	title={`${site.name} — ${t.cv.title}`}
	alternates={{ fr: '/cv/', en: '/en/cv/' }}
	noindex
	bodyClass="bg-zinc-100 print:bg-white"
>
	<style is:global>
		@page {
			size: A4;
			margin: 10mm 14mm;
		}
	</style>

	<main class="mx-auto my-8 max-w-[210mm] bg-white p-10 text-zinc-900 shadow-sm print:m-0 print:max-w-none print:p-0 print:shadow-none">
		<header class="flex flex-wrap items-end justify-between gap-4 border-b border-zinc-200 pb-4">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight">{site.name}</h1>
				<p class="mt-1 text-zinc-600">{t.hero.title}</p>
			</div>
			<ul class="text-right text-sm text-zinc-600">
				<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				<li><a href={site.url}>domelier.fr</a></li>
				<li><a href={site.github}>github.com/ar11tehau</a></li>
				<li><a href={site.linkedin}>linkedin.com/in/domelier</a></li>
			</ul>
		</header>

		<p class="mt-4 text-sm leading-relaxed text-zinc-700">{t.hero.lead}</p>

		<section class="mt-5">
			<h2 class="text-sm font-medium tracking-[0.15em] text-zinc-500 uppercase">{t.cv.skills}</h2>
			<ul class="mt-3 flex flex-wrap gap-1.5">
				{skills.map((skill) => <li class="rounded border border-zinc-200 px-2 py-0.5 text-xs text-zinc-700">{skill}</li>)}
			</ul>
		</section>

		<section class="mt-5">
			<Timeline heading={t.career.experience} items={t.career.experienceItems} variant="print" />
		</section>

		<div class="mt-5 grid grid-cols-2 gap-10 break-inside-avoid">
			<div>
				<h3 class="text-sm font-medium tracking-[0.15em] text-zinc-500 uppercase">{t.career.education}</h3>
				<ul class="mt-3 space-y-2">
					{
						t.career.educationItems.map((item) => (
							<li class="text-[13px] leading-snug">
								<p>
									<span class="text-zinc-500 tabular-nums">{item.period}</span>
									<span class="font-medium text-zinc-900"> · {item.title}</span>
								</p>
								<p class="text-zinc-600">{item.place}</p>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3 class="text-sm font-medium tracking-[0.15em] text-zinc-500 uppercase">{t.projects.title}</h3>
				<ul class="mt-3 space-y-2">
					{
						projects.map((project) => (
							<li class="text-[13px] leading-snug">
								<span class="font-medium">{project.title}</span>
								{project.url && <span class="text-zinc-500"> — {project.url.replace('https://', '')}</span>}
								<p class="text-zinc-600">{project.tags.join(' · ')}</p>
							</li>
						))
					}
				</ul>
				<p class="mt-3 text-[13px] text-zinc-700">{t.career.languages}</p>
			</div>
		</div>

		<p class="mt-10 text-sm print:hidden">
			<a href={t.cv.file} class="underline underline-offset-4">{t.cv.print}</a>
			<span class="text-zinc-400"> · </span>
			<a href={home} class="underline underline-offset-4">{site.url.replace('https://', '')}</a>
		</p>
	</main>
</Layout>
