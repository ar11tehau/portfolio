---
import type { Content } from '../i18n/content';

interface Props {
	t: Content;
}

const { t } = Astro.props;
---

<section class="bg-zinc-950 px-6 py-24 text-zinc-100" aria-labelledby="expertise-heading">
	<div class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm font-medium tracking-[0.2em] text-zinc-400 uppercase">{t.expertise.eyebrow}</p>

		<h2 id="expertise-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
			{t.expertise.title}
		</h2>

		<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
			{
				t.expertise.domains.map((domain) => (
					<article class="flex flex-col rounded-lg border border-zinc-800 bg-zinc-950 p-6">
						<h3 class="text-base font-medium tracking-tight text-zinc-100">{domain.title}</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">{domain.description}</p>
						<ul class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-xs text-zinc-400">
							{domain.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
