---
interface Project {
	title: string;
	description: string;
	tags: readonly string[];
	status: 'production' | 'development';
	url?: string;
}

const projects: readonly Project[] = [
	{
		title: 'Impact Pareto',
		description:
			'Laboratoire technique et média multilingue. Architecture JAMStack automatisée, pipeline CI/CD sur VPS.',
		tags: ['Astro', 'Tailwind', 'GitHub Actions', 'API LLM'],
		status: 'production',
	},
	{
		title: 'Micro-SaaS BTP & Climat',
		description:
			"Plateforme d'aide à la décision pour la construction, basée sur l'ingénierie géospatiale et les données météo.",
		tags: ['Laravel', 'Vue.js', 'PostgreSQL', 'API Météo'],
		status: 'development',
	},
	{
		title: 'Snack Te Ava Iti',
		description:
			'Site vitrine d’un snack à Tahiti : menu dynamique, conversion XPF / EUR / USD, pensé mobile-first.',
		tags: ['Node.js', 'Express', 'Tailwind', 'Nginx'],
		status: 'production',
		url: 'https://snackteavaiti.com',
	},
];

const statusLabel = {
	production: 'En production',
	development: 'En développement',
} as const satisfies Record<Project['status'], string>;
---

<section id="projets" class="bg-zinc-950 px-6 py-24 text-zinc-100" aria-labelledby="projects-heading">
	<div class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm font-medium tracking-[0.2em] text-zinc-500 uppercase">Réalisations</p>

		<h2 id="projects-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
			Mes Projets
		</h2>

		<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project) => (
					<article class="relative flex flex-col rounded-lg border border-zinc-800 bg-zinc-950 p-6 transition-colors hover:border-zinc-600 hover:bg-zinc-900/50">
						<div class="flex items-center gap-2 text-xs font-medium text-zinc-500">
							<span
								class:list={[
									'size-1.5 rounded-full',
									project.status === 'production' ? 'bg-emerald-400' : 'bg-amber-400',
								]}
								aria-hidden="true"
							/>
							{statusLabel[project.status]}
						</div>
						<h3 class="mt-4 text-lg font-medium tracking-tight text-zinc-100">
							{project.url ? (
								<a
									href={project.url}
									target="_blank"
									rel="noopener noreferrer"
									class="after:absolute after:inset-0 focus-visible:outline-none"
								>
									{project.title}
									<svg
										class="ml-1 inline size-3.5 align-baseline text-zinc-500"
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M5 11 11 5M6 5h5v5" />
									</svg>
								</a>
							) : (
								project.title
							)}
						</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">{project.description}</p>
						<ul class="mt-6 flex flex-wrap gap-2">
							{project.tags.map((tag) => (
								<li class="rounded-md border border-zinc-800 bg-zinc-900 px-2.5 py-1 text-xs font-medium text-zinc-300">
									{tag}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
