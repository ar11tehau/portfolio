---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import type { Content } from '../i18n/content';

interface Props {
	t: Content;
}

const { t } = Astro.props;
---

<section id="projets" class="bg-sable px-6 py-24 text-ocean" aria-labelledby="projects-heading">
	<div class="mx-auto max-w-5xl">
		<SectionHeading index="02" eyebrow={t.projects.eyebrow} title={t.projects.title} id="projects-heading" />

		<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				t.projects.items.map((project) => (
					<article class="flex flex-col overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm shadow-ocean/5 transition-colors has-[a:hover]:border-lagon/50">
						<div class="relative aspect-[16/10] overflow-hidden border-b border-stone-200 bg-stone-100">
							{project.image ? (
								<Image
									src={project.image}
									alt=""
									widths={[400, 640]}
									sizes="(min-width: 1024px) 320px, (min-width: 768px) 50vw, 100vw"
									class="size-full object-cover object-top"
								/>
							) : (
								<div class="flex size-full items-center justify-center bg-[repeating-radial-gradient(circle_at_70%_40%,transparent_0_22px,rgba(11,143,156,0.22)_22px_23px)]">
									{project.status === 'development' && (
										<span class="font-mono text-xs tracking-[0.2em] text-lagon uppercase">
											{t.projects.status.development}
										</span>
									)}
								</div>
							)}
						</div>

						<div class="flex flex-1 flex-col p-6">
							<div class="flex items-center gap-2 font-mono text-[11px] tracking-wider text-slate-500 uppercase">
								<span
									class:list={[
										'size-1.5 rounded-full',
										project.status === 'production' ? 'bg-emerald-400' : 'bg-amber-400',
									]}
									aria-hidden="true"
								/>
								{t.projects.status[project.status]}
							</div>
							<h3 class="mt-3 font-display text-xl font-medium tracking-tight text-ocean">
								{project.url ? (
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										class="transition-colors hover:text-lagon focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lagon"
									>
										{project.title}
										<svg
											class="ml-1 inline size-3.5 align-baseline text-lagon"
											viewBox="0 0 16 16"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											aria-hidden="true"
										>
											<path d="M5 11 11 5M6 5h5v5" />
										</svg>
									</a>
								) : (
									project.title
								)}
							</h3>
							<dl class="mt-3 flex-1 space-y-3 text-sm leading-relaxed">
								<div>
									<dt class="font-mono text-[11px] tracking-wider text-brique uppercase">{t.projects.needLabel}</dt>
									<dd class="mt-1 text-slate-600">{project.need}</dd>
								</div>
								<div>
									<dt class="font-mono text-[11px] tracking-wider text-lagon uppercase">{t.projects.answerLabel}</dt>
									<dd class="mt-1 text-slate-700">{project.answer}</dd>
								</div>
							</dl>
							<ul class="mt-6 flex flex-wrap gap-2">
								{project.tags.map((tag) => (
									<li class="rounded-md border border-stone-200 bg-sable px-2.5 py-1 font-mono text-[11px] text-slate-700">
										{tag}
									</li>
								))}
							</ul>
							{project.repo && (
								<a
									href={project.repo}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-5 w-fit font-mono text-[11px] tracking-wider text-lagon uppercase underline decoration-lagon/40 underline-offset-4 transition-colors hover:text-ocean hover:decoration-ocean focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lagon"
								>
									{t.projects.sourceLabel}
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
